    {
     "id": "D-MM-02",
     "pattern": "서로 같은 행렬|서로 같을 조건|서로 같은 경우",
     "axes": [
      "B1"
     ],
     "why": "두 행렬이 같을 조건 = 꼴이 같음 + 모든 대응 성분 일치. 꼴 조건 누락"
    },
    {
     "id": "D-MM-03",
     "pattern": "덧셈, 뺄셈, 실수배|덧셈|뺄셈|실수배",
     "axes": [
      "B1"
     ],
     "why": "덧셈·뺄셈은 꼴이 같을 때만 정의 — 연산 가능 조건 미확인"
    },
    {
     "id": "D-MM-04",
     "pattern": "행렬의 곱셈|곱셈의 정의|두 행렬의 곱|세 행렬의 곱|혼합계산",
     "axes": [
      "B1",
      "C2"
     ],
     "why": "곱셈 가능 조건(앞 행렬의 열 수 = 뒤 행렬의 행 수)과 결과 꼴 판정 누락"
    },
    {
     "id": "D-MM-05",
     "pattern": "AB≠BA|AB=BA|곱셈에 대한 성질|곱셈의 여러 가지 성질",
     "axes": [
      "C2",
      "B3"
     ],
     "why": "교환법칙 불성립 — 실수 연산 규칙을 그대로 적용. 성립하는 특수 경우 분류"
    },
    {
     "id": "D-MM-06",
     "pattern": "곱셈공식",
     "axes": [
      "C2",
      "D2"
     ],
     "why": "(A+B)²=A²+2AB+B² 는 AB=BA 일 때만 성립 — 조건 확인 없이 전개"
    },
    {
     "id": "D-MM-07",
     "pattern": "거듭제곱|A²|A³|Aⁿ|규칙 찾기",
     "axes": [
      "B3"
     ],
     "why": "Aⁿ 의 주기 — n을 주기로 나눈 나머지에 따른 경우 분류 누락"
    },
    {
     "id": "D-MM-08",
     "pattern": "Aⁿ=E",
     "axes": [
      "B3",
      "B1"
     ],
     "why": "Aⁿ=E 를 만족하는 최소 n(주기)을 먼저 확정해야 함"
    },
    {
     "id": "D-MM-09",
     "pattern": "단위행렬|AE=EA|Eⁿ|E가 포함|kE|A\\+kE",
     "axes": [
      "C2"
     ],
     "why": "E는 곱셈의 항등원이지 실수 1이 아님 — kE 와 상수 k 혼동"
    },
    {
     "id": "D-MM-10",
     "pattern": "행렬의 변형|A\\(a b\\)|Aⁿ\\(a b\\)|A\\(x y\\)",
     "axes": [
      "C4"
     ],
     "why": "A(a b)=k(a b) 꼴의 관계를 찾아 반복 적용하는 표현 변환 실패"
    },
    {
     "id": "D-MM-11",
     "pattern": "케일리|해밀턴",
     "axes": [
      "B1",
      "D2"
     ],
     "why": "A²-(a+d)A+(ad-bc)E=O 의 적용 방향 — 역은 성립하지 않음"
    },
    {
     "id": "D-MM-12",
     "pattern": "증명하기|증명",
     "axes": [
      "A3",
      "E1"
     ],
     "why": "성질 증명 — 임의의 행렬로 일반화하지 않고 특정 예로 확인하고 종료"
    },
    {
     "id": "D-MM-13",
     "pattern": "행렬 X를 구하는|등식을 만족하는 행렬",
     "axes": [
      "C2",
      "E1"
     ],
     "why": "행렬 방정식 — 양변에 곱하는 위치(좌·우)를 구분해야 함. 검산 누락"
    },
    {
     "id": "D-MM-14",
     "pattern": "xA\\+yB|나타내는 경우",
     "axes": [
      "C1"
     ],
     "why": "성분별 연립식 세우기 — 미지수 대응 실패"
    },
    {
     "id": "D-MM-15",
     "pattern": "계산결과의 의미|곱셈의 실생활",
     "axes": [
      "C1",
      "E3"
     ],
     "why": "행·열이 뜻하는 대상 설정 실패, 계산 결과의 의미·단위 미확인"
    }
   ]
  },
  "PF_M1S1": {
   "applies_to": [
    "PF_M1S1"
   ],
   "note": "소인수분해(중1-1). PF prefix 는 다항식의곱셈과인수분해(중3-1)와 충돌하므로 팩 키를 PF_M1S1 / PF_M3S1 로 분리해 호출할 것 (§17-7)",
   "rules": [
    {
     "id": "D-PF-01",
     "pattern": "자연수의 약수|자연수의 배수|약수와 배수",
     "axes": [
      "C2",
      "B3"
     ],
     "why": "a가 b의 약수 ↔ b가 a의 배수 — 방향 혼동. 1과 자기 자신 포함 여부"
    },
    {
     "id": "D-PF-02",
     "pattern": "배수판별",
     "axes": [
      "B1",
      "D2"
     ],
     "why": "판별 기준 선택 — 각 자리 숫자의 합/끝 두 자리 중 어느 조건인지"
    },
    {
     "id": "D-PF-03",
     "pattern": "소수와 합성수|합성수|소수의 이해|조건을 만족하는 소수",
     "axes": [
      "C2",
      "B3"
     ],
     "why": "1은 소수도 합성수도 아님. 2가 유일한 짝수 소수 — 경계 사례 누락"
    },
    {
     "id": "D-PF-04",
     "pattern": "거듭제곱의 밑과 지수|밑과 지수",
     "axes": [
      "C4",
      "C2"
     ],
     "why": "밑과 지수의 역할 혼동 — a×a×a=a³ 표현 변환 실패"
    },
    {
     "id": "D-PF-05",
     "pattern": "소인수분해 하기|나눗셈을 이용|세로셈|수형도|소인수분해하기",
     "axes": [
      "B1",
      "E1"
     ],
     "why": "소인수만 남을 때까지 나누지 않고 합성수를 남긴 채 종료. 곱해서 원래 수로 되돌려 확인 안 함"
    },
    {
     "id": "D-PF-06",
     "pattern": "소인수 구하기|소인수의 응용|소인수를 이용",
     "axes": [
      "C2"
     ],
     "why": "소인수와 약수 혼동 — 소인수는 인수 중 소수인 것만"
    },
    {
     "id": "D-PF-07",
     "pattern": "약수 구하기|약수의 개수|약수의 총합|주어진 수의 약수",
     "axes": [
      "B3",
      "E3"
     ],
     "why": "(지수+1)의 곱으로 세는 규칙 — 1과 자기 자신 포함 여부, 중복 누락"
    },
    {
     "id": "D-PF-08",
     "pattern": "최대공약수",
     "axes": [
      "C2",
      "B1"
     ],
     "why": "공통인 소인수의 지수 중 작은 것 — 최소공배수 규칙과 뒤바꿈"
    },
    {
     "id": "D-PF-09",
     "pattern": "최소공배수",
     "axes": [
      "C2",
      "B1"
     ],
     "why": "모든 소인수의 지수 중 큰 것 — 최대공약수 규칙과 뒤바꿈"
    },
    {
     "id": "D-PF-10",
     "pattern": "공약수",
     "axes": [
      "B3"
     ],
     "why": "공약수는 최대공약수의 약수 전체 — 일부만 나열하고 종료"
    },
    {
     "id": "D-PF-11",
     "pattern": "공배수",
     "axes": [
      "B3",
      "B2"
     ],
     "why": "공배수는 최소공배수의 배수 — 주어진 범위 안에서 세는 조건 누락"
    },
    {
     "id": "D-PF-12",
     "pattern": "최대공약수와 최소공배수의 관계|관계를 이용하여 수 구하기",
     "axes": [
      "B1",
      "B3"
     ],
     "why": "A×B=G×L 이용 — 서로소 조건 확인과 경우 분류 누락"
    },
    {
     "id": "D-PF-13",
     "pattern": "어떤 자연수로 나누기",
     "axes": [
      "C1",
      "C2"
     ],
     "why": "「~로 나누기」는 최대공약수 문제 — 「~를 나누기」와 조사 하나로 갈림"
    },
    {
     "id": "D-PF-14",
     "pattern": "어떤 자연수를 나누기",
     "axes": [
      "C1",
      "C2"
     ],
     "why": "「~를 나누기」는 최소공배수 문제 — 「~로 나누기」와 조사 하나로 갈림"
    },
    {
     "id": "D-PF-15",
     "pattern": "남거나 모자란|같은 수가 남",
     "axes": [
      "B4",
      "B1"
     ],
     "why": "남는 경우와 모자란 경우의 보정 부호(−/+)를 반대로 적용"
    },
    {
     "id": "D-PF-16",
     "pattern": "분수를 자연수로 만들기",
     "axes": [
      "C3",
      "B1"
     ],
     "why": "분자의 최대공약수와 분모의 최소공배수 — 꼴에 따라 반대로 적용"
    }
   ]
  },
  "EI_CMEI": {
    "applies_to": ["CMEI"],
    "note": "방정식과 부등식(고1 공통수학1). 12개 중영역이 복소수·이차방정식·이차함수·삼사차·연립·부등식 6계열로 나뉘며 팩도 그 순서로 구성",
    "rules": [
      {"id": "D-CMEI-01", "pattern": "복소수의 뜻과 분류|실수, 허수, 순허수|허수 표현", "axes": ["C2", "B3"], "why": "실수·허수·순허수 분류 — 순허수는 실수부=0 이고 허수부≠0. 0의 취급 누락"},
      {"id": "D-CMEI-02", "pattern": "실수 또는 순허수가 되는 조건|실수가 되는 경우", "axes": ["B1", "B4"], "why": "실수부=0 과 허수부=0 중 어느 조건인지, b≠0 단서 누락"},
      {"id": "D-CMEI-03", "pattern": "복소수가 서로 같을 조건", "axes": ["B1"], "why": "실수부와 허수부를 각각 비교해야 함 — 한쪽 식만 세우고 종료"},
      {"id": "D-CMEI-04", "pattern": "켤레복소수", "axes": ["C2", "D2"], "why": "켤레의 성질(합=2a, 곱=a²+b²) 적용 — 부호와 대상 혼동"},
      {"id": "D-CMEI-05", "pattern": "i의 거듭제곱|복소수의 거듭제곱", "axes": ["B3"], "why": "i의 주기 4 — 지수를 4로 나눈 나머지에 따른 경우 분류 누락"},
      {"id": "D-CMEI-06", "pattern": "음수의 제곱근", "axes": ["B4", "B1"], "why": "√a√b=−√(ab) 가 되는 경우(a<0,b<0) 와 √(b/a) 의 부호 조건 미확인"},
      {"id": "D-CMEI-07", "pattern": "복소수의 사칙연산|고차식의 값|복소수가 주어질 때의 식의 값", "axes": ["C4", "E1"], "why": "i²=−1 치환 후 실수부·허수부로 정리 — 변환 도중 종료"},
      {"id": "D-CMEI-08", "pattern": "근의 판별|판별식", "axes": ["B3", "B1"], "why": "D>0 / D=0 / D<0 경계 — 「서로 다른 두 실근」에 D=0 포함 여부"},
      {"id": "D-CMEI-09", "pattern": "계수가 문자인|이차항이 미정계수", "axes": ["B1", "B3"], "why": "이차항 계수가 0 이면 일차방정식 — 그 경우를 따로 분류하지 않음"},
      {"id": "D-CMEI-10", "pattern": "근과 계수의 관계|두 근의 합|두 근의 곱", "axes": ["D2", "B4"], "why": "α+β=−b/a 의 부호, α−β 는 두 경우(±)"},
      {"id": "D-CMEI-11", "pattern": "켤레근", "axes": ["B1"], "why": "계수가 유리수·실수라는 전제 확인 — 무리수근·허근이 짝으로 나오는 조건"},
      {"id": "D-CMEI-12", "pattern": "잘못 보고 푼|잘못 쓴", "axes": ["B1", "E1"], "why": "잘못 본 계수만 무효이고 나머지는 유효 — 어느 쪽을 살릴지 혼동"},
      {"id": "D-CMEI-13", "pattern": "한 근이 주어진|근이 주어진", "axes": ["E1"], "why": "대입해 미정계수를 구한 뒤 나머지 근을 원식에서 재확인 안 함"},
      {"id": "D-CMEI-14", "pattern": "절댓값 기호를 포함한|절댓값 기호가 두 개|절댓값이 포함된", "axes": ["B3", "B2"], "why": "절댓값 안 식의 부호로 구간 분류 — 각 구간의 해가 그 구간에 드는지 미확인"},
      {"id": "D-CMEI-15", "pattern": "가우스 기호", "axes": ["B3", "B2"], "why": "[x] 의 구간 분류와 정수 조건 처리 누락"},
      {"id": "D-CMEI-16", "pattern": "완전제곱식", "axes": ["B1"], "why": "완전제곱식 조건 = 판별식 0 — 이차항 계수 조건 함께 세우기"},
      {"id": "D-CMEI-17", "pattern": "그래프와 x축의 교점|그래프와 직선의 교점|실근의 개수와 함수의 그래프", "axes": ["C3", "B3"], "why": "교점 ↔ 방정식의 실근 대응을 연결하지 못함"},
      {"id": "D-CMEI-18", "pattern": "위치 관계|위치관계", "axes": ["B3", "B1"], "why": "만난다·접한다·만나지 않는다 → 판별식 부호 세 경우. 「접한다」는 D=0 하나뿐"},
      {"id": "D-CMEI-19", "pattern": "제한된 범위", "axes": ["B2", "B3"], "why": "꼭짓점이 범위 안인지 밖인지에 따라 최대·최소 위치가 달라짐 — 경우 분류"},
      {"id": "D-CMEI-20", "pattern": "최댓값 또는 최솟값이 주어졌을|최댓값의 최솟값|최솟값의 최댓값|꼭짓점의 x좌표가 미지수", "axes": ["B3", "B2"], "why": "미지수의 위치에 따른 경우 분류 누락"},
      {"id": "D-CMEI-21", "pattern": "공통부분이 있는|t로 치환|치환을 이용", "axes": ["B2"], "why": "치환한 변수의 범위를 다시 구해야 함 — 원래 변수의 범위를 그대로 사용"},
      {"id": "D-CMEI-22", "pattern": "실근의 위치|실근의 부호", "axes": ["B1", "B3"], "why": "f(p) 의 부호 · 판별식 · 축의 위치 세 조건을 모두 세워야 함"},
      {"id": "D-CMEI-23", "pattern": "항상 성립할 조건|항상 성립하는", "axes": ["B1", "B4"], "why": "이차항 계수의 부호와 판별식 조건 둘 다 필요. 계수=0 인 경우 별도"},
      {"id": "D-CMEI-24", "pattern": "해를 갖지 않을 조건|해를 가질 조건|해를 한 개만|해를 갖거나 갖지 않는", "axes": ["B3", "B1"], "why": "「해가 없다」는 반대 부등식이 항상 성립 — 여집합 관계 전환 실패"},
      {"id": "D-CMEI-25", "pattern": "해가 주어진|해의 조건이 주어진", "axes": ["C3", "B4"], "why": "해가 α<x<β 면 이차항 계수>0 이고 근이 α,β — 부호와 근을 역으로 구성"},
      {"id": "D-CMEI-26", "pattern": "연립일차부등식의 풀이|연립이차부등식의 풀이|A<B<C|특수한 해를 갖는", "axes": ["B3", "B2"], "why": "각 부등식의 해를 구한 뒤 공통 범위 — 수직선에서 경계 포함 여부"},
      {"id": "D-CMEI-27", "pattern": "부등식의 기본성질|부등식 ax>b", "axes": ["B4"], "why": "양변에 음수를 곱·나눌 때 부등호 방향. a 의 부호로 경우 분류(a=0 포함)"},
      {"id": "D-CMEI-28", "pattern": "정수인 해의 개수|정수해|정수인 해", "axes": ["B2", "B3"], "why": "경계값 포함 여부에 따라 정수의 개수가 달라짐"},
      {"id": "D-CMEI-29", "pattern": "부등식의 활용|방정식의 활용|이차함수와 이차방정식의 활용|최대·최소의 활용", "axes": ["C1", "E2"], "why": "미지수 설정과 식 세우기, 구한 해가 상황 조건(자연수·길이>0)을 만족하는지 미확인"},
      {"id": "D-CMEI-30", "pattern": "포함관계를 만족하도록|f\\(ax\\+b\\)", "axes": ["C3"], "why": "해집합의 포함관계로 조건을 바꿔 세우지 못함"},
      {"id": "D-CMEI-31", "pattern": "삼차방정식|사차방정식|삼·사차", "axes": ["B3", "B1"], "why": "인수분해 후 남은 이차식의 근 판별 — 허근 포함 여부와 중복근 처리"},
      {"id": "D-CMEI-32", "pattern": "허근의 성질|x³=1", "axes": ["B1", "D2"], "why": "ω 의 성질(ω²+ω+1=0, ω³=1) 적용 — 지수의 나머지 처리"},
      {"id": "D-CMEI-33", "pattern": "공통근", "axes": ["B1", "E1"], "why": "연립해 얻은 값이 실제로 두 방정식을 모두 만족하는지 확인 안 함"},
      {"id": "D-CMEI-34", "pattern": "연립이차방정식|연립일차방정식|소거하는|대칭식", "axes": ["B3", "E2"], "why": "대입 후 생기는 해의 쌍을 모두 나열하고 무연근을 확인해야 함"},
      {"id": "D-CMEI-35", "pattern": "부정방정식", "axes": ["B1", "B3"], "why": "정수·실수 조건이 추가 제약 — (정수)×(정수) 꼴로 만들어 약수 경우 분류"},
      {"id": "D-CMEI-36", "pattern": "판별식과 삼각형", "axes": ["B1"], "why": "삼각형 성립 조건(두 변의 합 > 나머지 변)을 함께 세워야 함"},
      {"id": "D-CMEI-37", "pattern": "계수의 부호|지나는 사분면|그래프의 개형", "axes": ["B4", "C3"], "why": "그래프 개형에서 계수의 부호 읽기 — 축의 위치(−b/2a)와 y절편(c)을 각각 대응시켜야 함"},
      {"id": "D-CMEI-38", "pattern": "이차함수의 식 구하기|이차함수 구하기", "axes": ["C1"], "why": "조건에 따라 표준형·일반형·인수분해꼴 중 어느 꼴로 세울지 선택 실패"}
    ]
  },
  "SQ_ASQ": {
    "applies_to": ["ASQ"],
    "note": "수열(고2 대수). 「여러 가지 수열의 합의 활용」 77건은 묶음이 하나이고 이름이 문장형이라 D-ASQ-20~22 가 이름 쪽에서 잡는다",
    "rules": [
      {"id": "D-ASQ-01", "pattern": "등차수열의 일반항", "axes": ["C1", "D2"], "why": "a_n=a+(n−1)d — 항 번호에서 n 과 n−1 을 혼동"},
      {"id": "D-ASQ-02", "pattern": "등차중항", "axes": ["D2", "B1"], "why": "2b=a+c — 가운데 항이 어느 것인지 확인 없이 대입"},
      {"id": "D-ASQ-03", "pattern": "등차수열의 합\\(1\\)|등차수열의 합\\(3\\)|등차수열의 합\\(2\\)", "axes": ["D2", "B2"], "why": "S_n 공식 선택(끝항 아는 꼴 vs 공차 아는 꼴)과 항의 개수 세기"},
      {"id": "D-ASQ-04", "pattern": "합의 최대·최소|합의 활용\\(1\\)", "axes": ["B4", "B3"], "why": "첫 항과 공차의 부호로 항이 음수로 바뀌는 지점을 찾아야 함 — 부호 분기 누락"},
      {"id": "D-ASQ-05", "pattern": "두 수 사이에 수를 넣어", "axes": ["B1"], "why": "n 개를 넣으면 항은 n+2 개, 공차의 분모는 n+1 — 개수 어긋남"},
      {"id": "D-ASQ-06", "pattern": "나머지가 같은 자연수의 합", "axes": ["B3", "B2"], "why": "주어진 범위 안의 항 수 세기 — 양 끝 포함 여부"},
      {"id": "D-ASQ-07", "pattern": "등비수열의 일반항", "axes": ["C1", "D2"], "why": "a_n=ar^(n−1) — 지수에서 n 과 n−1 혼동"},
      {"id": "D-ASQ-08", "pattern": "등비중항", "axes": ["B4", "B3"], "why": "b²=ac 이므로 b 의 부호가 두 경우 — 한쪽만 답함"},
      {"id": "D-ASQ-09", "pattern": "등비수열의 합", "axes": ["B3", "B1"], "why": "공비 r=1 인 경우를 따로 분류하지 않고 공식에 그대로 대입"},
      {"id": "D-ASQ-10", "pattern": "원리합계", "axes": ["C1", "E3"], "why": "기수불·기말불 구분과 적립 횟수 — 상황을 식으로 옮기기 실패, 단위 확인"},
      {"id": "D-ASQ-11", "pattern": "항 사이의 관계가 주어진|조건을 만족시키는", "axes": ["C1", "B1"], "why": "주어진 관계식을 첫 항과 공차(공비)에 대한 연립식으로 세우지 못함"},
      {"id": "D-ASQ-12", "pattern": "합과 일반항 사이의 관계|a_n과 S_n", "axes": ["B1", "B3"], "why": "a_n=S_n−S_(n−1) 은 n≥2 에서만 — a_1=S_1 을 따로 확인하지 않음"},
      {"id": "D-ASQ-13", "pattern": "합의 기호|Σ의 성질", "axes": ["B1", "D2"], "why": "Σ(a_k b_k) ≠ Σa_k·Σb_k, 상수의 합은 nc — 성질 오적용"},
      {"id": "D-ASQ-14", "pattern": "자연수의 거듭제곱의 합", "axes": ["D2"], "why": "차수에 따른 공식 선택 — n(n+1)/2 와 n(n+1)(2n+1)/6 혼동"},
      {"id": "D-ASQ-15", "pattern": "분수의 꼴인 수열의 합|부분분수", "axes": ["C4", "B1"], "why": "부분분수로 분해해 소거 — 소거 후 남는 항을 잘못 셈"},
      {"id": "D-ASQ-16", "pattern": "근호가 포함된 수열의 합", "axes": ["C4"], "why": "분모 유리화 후 소거 꼴로 변형 실패"},
      {"id": "D-ASQ-17", "pattern": "로그가 포함된 수열의 합", "axes": ["C4", "D2"], "why": "로그의 성질로 합을 곱으로 바꾸는 변환 — 밑과 진수 처리"},
      {"id": "D-ASQ-18", "pattern": "Σ를 여러 개 포함|Σ를 2개", "axes": ["B2", "B3"], "why": "안쪽 Σ 의 변수와 범위를 바깥과 구분하지 못함"},
      {"id": "D-ASQ-19", "pattern": "특정한 값이 반복되는", "axes": ["B3"], "why": "반복 주기를 찾아 나머지로 분류해야 함"},
      {"id": "D-ASQ-20", "pattern": "교점|좌표평면|평면도형|입체도형|그래프|도형", "axes": ["C1"], "why": "도형·좌표 상황을 일반항 a_n 의 식으로 옮기지 못함"},
      {"id": "D-ASQ-21", "pattern": "개수", "axes": ["B3", "B2"], "why": "조건을 만족하는 것 세기 — 경계 포함 여부와 중복"},
      {"id": "D-ASQ-22", "pattern": "나눈 나머지|나머지로 정의", "axes": ["B3"], "why": "나머지의 주기를 찾아 경우 분류"},
      {"id": "D-ASQ-23", "pattern": "귀납적으로 정의|귀납적 정의", "axes": ["B1", "C3"], "why": "점화식의 시작값(n 의 범위)과 첫 항 확인 누락"},
      {"id": "D-ASQ-24", "pattern": "같은 수가 반복되는 수열", "axes": ["B3"], "why": "주기를 찾아 n 을 주기로 나눈 나머지로 분류"},
      {"id": "D-ASQ-25", "pattern": "수학적 귀납법", "axes": ["A3", "B1"], "why": "n=k 가정을 실제로 사용했는지, 출발값에서 성립함을 먼저 보였는지"},
      {"id": "D-ASQ-26", "pattern": "배수의 증명", "axes": ["B1"], "why": "n=k+1 식을 n=k 식의 배수 꼴로 정리하는 과정 누락"},
      {"id": "D-ASQ-27", "pattern": "항을 묶어 규칙 찾기", "axes": ["B3", "B2"], "why": "묶음의 경계와 몇 번째 묶음인지 — 항 번호 대응"},
      {"id": "D-ASQ-28", "pattern": "수열의 일반항|규칙을 찾아", "axes": ["C3"], "why": "나열된 항에서 규칙(차·비·계차)을 찾아 일반항으로 연결하지 못함"},
      {"id": "D-ASQ-29", "pattern": "등차수열을 이루는 수|등비수열을 이루는 수|등차수열과 등비수열|이루는 경우", "axes": ["C1", "B1"], "why": "미지수를 a−d, a, a+d (또는 a/r, a, ar) 로 대칭 배치해야 계산이 정리됨"},
      {"id": "D-ASQ-30", "pattern": "Σ를 이용하여 나타내어진|sum_", "axes": ["D2", "C4"], "why": "Σ 표기를 전개해 공식이 적용되는 꼴로 바꾸는 변환 실패"}
    ]
  },
  "TF_ATF": {
    "applies_to": ["ATF"],
    "note": "삼각함수(고2 대수). 최대 묶음 「여러 가지 각의 삼각함수(1)」 44건은 π/2±θ·π±θ 변환의 이름 변경과 부호가 핵심이라 D-ATF-20 이 묶음에서 잡는다",
    "rules": [
      {"id": "D-ATF-01", "pattern": "일반각|동경이 나타내는", "axes": ["B3"], "why": "360°×n+θ 로 나타낼 때 정수 n 의 범위 — 같은 동경을 나타내는 각이 무수히 많음"},
      {"id": "D-ATF-02", "pattern": "두 동경의 위치 관계", "axes": ["B3", "C2"], "why": "일치는 차가 360°n, 원점 대칭은 180°+360°n, 축 대칭은 합이 360°n — 조건을 뒤바꿈"},
      {"id": "D-ATF-03", "pattern": "사분면의 각", "axes": ["B3", "B2"], "why": "θ/n 의 사분면은 n 으로 나눈 범위를 다시 분류해야 함 — 경우 누락"},
      {"id": "D-ATF-04", "pattern": "육십분법과 호도법", "axes": ["C4", "D2"], "why": "π ↔ 180° 변환 — 비례식 방향을 반대로 적용"},
      {"id": "D-ATF-05", "pattern": "부채꼴의 호의 길이와 넓이", "axes": ["D2", "E3"], "why": "l=rθ, S=½r²θ 는 호도법 전제 — 육십분법 각을 그대로 대입. 단위 확인"},
      {"id": "D-ATF-06", "pattern": "부채꼴의 둘레의 길이와 넓이의 최대·최소", "axes": ["B1", "B2"], "why": "둘레=2r+l 조건 아래의 최대·최소 — 조건식을 세우지 않고 바로 미분·평균 적용"},
      {"id": "D-ATF-07", "pattern": "삼각함수의 정의", "axes": ["C4", "B1"], "why": "동경 위 점의 좌표와 r 로 정의 — r>0 조건과 좌표의 부호 처리"},
      {"id": "D-ATF-08", "pattern": "값의 부호", "axes": ["B4", "B3"], "why": "사분면별 부호 — 어느 함수가 양수인지 사분면마다 분류해야 함"},
      {"id": "D-ATF-09", "pattern": "삼각함수 사이의 관계", "axes": ["D2", "C4"], "why": "sin²θ+cos²θ=1, tanθ=sinθ/cosθ 중 어느 것으로 변환할지 선택"},
      {"id": "D-ATF-10", "pattern": "sinθ±cosθ|sinθcosθ", "axes": ["B4", "D2"], "why": "양변을 제곱해 관계식을 얻은 뒤 부호를 각의 범위로 확정해야 함"},
      {"id": "D-ATF-11", "pattern": "삼각함수와 이차방정식", "axes": ["B1", "D2"], "why": "근과 계수의 관계와 sin²+cos²=1 을 함께 세워야 함"},
      {"id": "D-ATF-12", "pattern": "최대·최소와 주기", "axes": ["D2", "B1"], "why": "y=a sin(bx+c)+d 의 최대는 |a|+d, 주기는 2π/|b| — 절댓값을 빠뜨림"},
      {"id": "D-ATF-13", "pattern": "y=tanx의 그래프", "axes": ["C2", "B2"], "why": "탄젠트는 주기 π 이고 점근선이 있음 — 사인·코사인 성질을 그대로 적용"},
      {"id": "D-ATF-14", "pattern": "평행이동과 대칭이동", "axes": ["C4", "B4"], "why": "bx+c=b(x+c/b) 이므로 x 방향 이동량은 c 가 아니라 c/b"},
      {"id": "D-ATF-15", "pattern": "그래프의 대칭성", "axes": ["C2", "B1"], "why": "대칭축과 대칭 중심의 위치 — 최대·최소점과 x축 교점 중 어디인지"},
      {"id": "D-ATF-16", "pattern": "미정계수의 결정", "axes": ["C3", "B1"], "why": "최대·최소로 a·d, 주기로 b, 지나는 점으로 c — 어느 조건이 어느 계수인지 대응"},
      {"id": "D-ATF-17", "pattern": "절댓값 기호를 포함한 삼각함수", "axes": ["B3", "C2"], "why": "|sin x| 는 주기가 반, sin|x| 는 다름 — 절댓값의 위치에 따라 개형이 달라짐"},
      {"id": "D-ATF-18", "pattern": "주기함수", "axes": ["B1"], "why": "f(x+p)=f(x) 의 최소 양수 p — 주기의 정의 확인"},
      {"id": "D-ATF-19", "pattern": "값의 대소 비교", "axes": ["B2", "C3"], "why": "각을 같은 범위로 옮긴 뒤 그래프의 증감으로 비교"},
      {"id": "D-ATF-20", "pattern": "여러 가지 각의 삼각함수", "axes": ["C4", "B4"], "why": "π/2±θ 는 함수 이름이 바뀌고 π±θ 는 안 바뀜 — 이름 변경과 부호 두 단계"},
      {"id": "D-ATF-21", "pattern": "포함된 방정식|삼각방정식", "axes": ["B2", "B3"], "why": "주어진 범위 안의 해를 모두 — 한 주기에 해가 둘인 것을 하나만 답함"},
      {"id": "D-ATF-22", "pattern": "포함된 부등식|삼각부등식", "axes": ["B2", "B4"], "why": "그래프에서 부등호 방향과 범위 경계 포함 여부"},
      {"id": "D-ATF-23", "pattern": "함수의 최대·최소\\(1\\)|함수의 최대·최소\\(2\\)|함수의 최대·최소\\(3\\)", "axes": ["B2"], "why": "치환한 t 의 범위(−1≤t≤1)를 다시 구하지 않고 이차함수의 꼭짓점을 그대로 사용"},
      {"id": "D-ATF-24", "pattern": "삼각방정식의 실근|근의 조건", "axes": ["B3", "C3"], "why": "그래프와 직선의 교점 개수로 옮겨 경우 분류"},
      {"id": "D-ATF-25", "pattern": "사인법칙", "axes": ["D2", "B1"], "why": "a/sin A = 2R — 2R 를 R 로 쓰거나 대응하는 대각을 잘못 잡음"},
      {"id": "D-ATF-26", "pattern": "코사인법칙", "axes": ["D2", "B4"], "why": "a²=b²+c²−2bc cos A — 부호와 끼인각 대응"},
      {"id": "D-ATF-27", "pattern": "삼각형의 넓이|사각형의 넓이|헤론", "axes": ["D2", "B1"], "why": "½ab sin C 는 C 가 두 변의 끼인각일 때만 — 끼인각이 아닌 각을 대입"},
      {"id": "D-ATF-28", "pattern": "외접원|내접원", "axes": ["D2", "C2"], "why": "외접원 R 과 내접원 r 의 공식을 구분 — S=rs 와 abc/4R 혼동"},
      {"id": "D-ATF-29", "pattern": "최대각,최소각|최대각·최소각", "axes": ["C2", "B1"], "why": "가장 큰 각은 가장 긴 변의 대각 — 대응을 뒤집음"},
      {"id": "D-ATF-30", "pattern": "모양 결정|모양 판단", "axes": ["C3", "B3"], "why": "조건식을 변의 관계로 바꿔 판정 — 이등변·직각 경우를 모두 확인"},
